NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- 以下は課金(Stripe)用。サーバー側だけで使う秘密情報なので、NEXT_PUBLIC_ を付けないこと ---
# Supabase「Project Settings > API」の service_role キー(webhookが契約状況を書き込むために使う)
SUPABASE_SERVICE_ROLE_KEY=
# Stripe「開発者 > APIキー」のシークレットキー(テスト中は sk_test_...)
STRIPE_SECRET_KEY=
# scripts/stripe-setup.mjs が表示する値
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=
